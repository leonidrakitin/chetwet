<div class="p-6 max-w-4xl">
  <div class="mb-4">
    <%= link_to '← Back to Suggestions', super_admin_suggestions_path, class: 'text-blue-600 hover:underline text-sm' %>
  </div>

  <div class="bg-white rounded-lg border p-6 mb-6">
    <div class="flex items-center justify-between mb-4">
      <h1 class="text-2xl font-bold"><%= @suggestion.title %></h1>
      <% status_classes = { 'pending' => 'bg-yellow-100 text-yellow-800', 'approved' => 'bg-green-100 text-green-800', 'rejected' => 'bg-red-100 text-red-800' } %>
      <span class="px-3 py-1 rounded-full text-sm font-medium <%= status_classes[@suggestion.status] %>">
        <%= @suggestion.status.capitalize %>
      </span>
    </div>

    <div class="text-gray-700 mb-4 prose max-w-none">
      <%= sanitize(
            @suggestion.description.to_s,
            tags: Suggestion::DESCRIPTION_HTML_TAGS,
            attributes: %w[href rel target]
          ) %>
    </div>

    <% if @suggestion.images.attached? %>
      <div class="mb-4">
        <h3 class="text-sm font-medium text-gray-700 mb-2">Photos</h3>
        <div class="flex flex-wrap gap-2">
          <% @suggestion.images.each do |image| %>
            <%= image_tag image.variant(resize_to_limit: [400, 400]), class: 'w-24 h-24 object-cover rounded border border-gray-200' %>
          <% end %>
        </div>
      </div>
    <% end %>

    <div class="flex gap-4 text-sm text-gray-500 mb-4">
      <span>Account: <strong><%= @suggestion.account.name %></strong></span>
      <span>Author: <strong><%= @suggestion.user.name %></strong></span>
      <span>Created: <strong><%= @suggestion.created_at.strftime('%Y-%m-%d %H:%M') %></strong></span>
      <span class="text-green-600">&#x25B2; <%= @suggestion.upvotes_count %></span>
      <span class="text-red-600">&#x25BC; <%= @suggestion.downvotes_count %></span>
    </div>

    <div class="flex gap-2 mb-6">
      <% if @suggestion.status != 'approved' %>
        <%= button_to 'Approve', approve_super_admin_suggestion_path(@suggestion), method: :post, class: 'bg-green-600 text-white px-4 py-2 rounded text-sm cursor-pointer hover:bg-green-700' %>
      <% end %>
      <% if @suggestion.status != 'rejected' %>
        <%= button_to 'Reject', reject_super_admin_suggestion_path(@suggestion), method: :post, class: 'bg-red-600 text-white px-4 py-2 rounded text-sm cursor-pointer hover:bg-red-700' %>
      <% end %>
      <%= button_to 'Delete', super_admin_suggestion_path(@suggestion), method: :delete, data: { confirm: 'Are you sure?' }, class: 'bg-gray-600 text-white px-4 py-2 rounded text-sm cursor-pointer hover:bg-gray-700' %>
    </div>
  </div>

  <div class="bg-white rounded-lg border p-6">
    <h2 class="text-lg font-semibold mb-4">Tags</h2>
    <div class="flex flex-wrap gap-2 mb-4">
      <% (@suggestion.tags || []).each do |tag| %>
        <span class="inline-flex items-center gap-1 bg-blue-100 text-blue-800 text-sm px-3 py-1 rounded-full">
          <%= tag %>
          <%= button_to '×', remove_tag_super_admin_suggestion_path(@suggestion, tag: tag), method: :delete, class: 'text-blue-600 hover:text-blue-900 font-bold' %>
        </span>
      <% end %>
    </div>

    <%= form_tag add_tag_super_admin_suggestion_path(@suggestion), method: :post, class: 'flex gap-2' do %>
      <%= text_field_tag :tag, nil, placeholder: 'e.g. "approved" or "in release 23.05"', class: 'border rounded px-3 py-2 text-sm flex-1' %>
      <%= submit_tag 'Add Tag', class: 'bg-blue-600 text-white px-4 py-2 rounded text-sm cursor-pointer hover:bg-blue-700' %>
    <% end %>
  </div>
</div>
